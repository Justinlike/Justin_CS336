# ==========================================
# 1. Python 核心忽略项
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# 2. 虚拟环境 (根据你的提示符 (CV)，你可能在用 Conda 或 venv)
# ==========================================
venv/
env/
.venv/
ENV/
conda-env/

# ==========================================
# 3. 深度学习特有 (极其重要：不要上传巨大的模型权重和数据集)
# ==========================================
# 模型权重文件
*.pth
*.pt
*.ckpt
*.safetensors
*.h5
*.pb

# 数据集文件夹 (假设你的数据放在这些目录下)
data/
datasets/
SleepEDF/
*.zip
*.tar.gz
*.csv

# 训练输出、日志和检查点
logs/
runs/
checkpoints/
output/
*.log

# ==========================================
# 4. IDE 和编辑器配置
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# 5. 操作系统生成的文件
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# 6. Jupyter Notebook 输出 (可选，如果你用 Jupyter)
# ==========================================
.ipynb_checkpoints/

# ==========================================
# 7. 其他项目特定文件 (按需修改)
# ==========================================
# 如果你有敏感的 API Key 或配置文件，务必忽略
.env
config_secret.yaml